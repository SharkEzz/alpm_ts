{
  "name": "alpm-ts",
  "version": "0.1.0",
  "description": "TypeScript CLI over libalpm for querying the Arch package database",
  "license": "MIT",
  "type": "module",
  "bin": {
    "alpm": "src/cli/index.ts"
  },
  "files": [
    "src",
    "native/binding.gyp",
    "native/src"
  ],
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "install": "node-gyp rebuild --directory=native",
    "typecheck": "tsc",
    "test": "node --test",
    "clean": "rm -rf native/build"
  },
  "dependencies": {
    "commander": "15.0.0",
    "node-addon-api": "8.9.2"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "node-gyp": "13.0.2",
    "typescript": "7.0.2"
  }
}
