{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "lib": ["ES2024"],
    "types": ["node"],
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true
  }
}
